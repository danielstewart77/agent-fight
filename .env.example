# All run settings (ADO org/project, webhook shared secret, clone credential)
# are entered through the admin console at /admin/settings — see
# app/orm.py::Settings. There are no ADO/webhook env vars.

# Server settings
PORT=8890
ENABLE_LOGGING=true

# SQLite database. Relative paths resolve against the repo root.
DB_PATH=data/agent_fight.db

# Docker image used for each per-review container. Built from Dockerfile.review
# (git + the claude/codex CLIs). The per-harness inference-proxy connections are
# configured through /admin/proxy, not here.
REVIEW_IMAGE=agent-fight-review:latest

# Host directory holding one clone of each skills repo (claude-skills,
# codex-skills). Cloned/pulled via /admin/skills and bind-mounted read-only
# into review containers. The repo URLs and per-harness skill selection are set
# in the admin console, not here.
#
# IMPORTANT when running the app itself in Docker (docker-compose.yml): review
# containers are launched by the HOST daemon (Docker-out-of-Docker), so this
# must be an ABSOLUTE host path, and compose mounts it at the same path inside
# the app container. A relative path (or a container-only path like
# /app/data/skills) will not resolve on the host and skill mounts will fail.
# Running the app directly on the host, a relative path like data/skills is fine.
SKILLS_ROOT=/srv/agent-fight/skills

# Admin console. The admin is a single operator identity, not a database row;
# leaving these unset makes the console unreachable.
ADMIN_USERNAME=daniel
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-in-production
