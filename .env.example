# All run settings (ADO org/project, webhook shared secret, clone credential)
# are entered through the admin console at /admin/settings — see
# app/orm.py::Settings. There are no ADO/webhook env vars.

# Server settings
PORT=8890
ENABLE_LOGGING=true

# SQLite database. Relative paths resolve against the repo root.
DB_PATH=data/agent_fight.db

# Admin console. The admin is a single operator identity, not a database row;
# leaving these unset makes the console unreachable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-in-production
